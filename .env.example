# Supabase Auth & DB
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Gemini AI — powers SoF vision extraction and the legal drafter.
# Use a Google AI Studio API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY="your-gemini-key"
GEMINI_MODEL="gemini-2.5-pro"
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash"  # extraction fallback (optional)
NEXTAUTH_URL="http://localhost:3000"

# Shared secret required in the `x-init-secret` header to call /api/init-demo.
# Generate with: openssl rand -hex 32
INIT_DEMO_SECRET="your-random-secret"

# Legal drafter model (optional; defaults to GEMINI_MODEL, then gemini-2.5-pro).
# DRAFTER_MODEL_ID="gemini-2.5-pro"

# Sanctions screening (optional) — OpenSanctions-compatible matching API.
# Without a key, screening reports "unavailable" (never a silent pass).
# SANCTIONS_API_URL="https://api.opensanctions.org"
# SANCTIONS_API_KEY="your-opensanctions-key"

# EU ETS estimator (optional) — EUA allowance price override, EUR/tCO2.
# ETS_EUA_PRICE_EUR="75"

# ERP sync worker (optional) — shared secret for the external scheduler to
# call POST /api/integrations/run-sync with the `x-cron-secret` header.
# CRON_SECRET="your-random-secret"

# Evidence verification — AIS position history (optional).
# Weather corroboration needs no key (Open-Meteo archive). AIS verification
# activates only when a commercial provider is configured; {imo}, {from}, {to}
# are substituted into the URL template.
# AIS_PROVIDER_URL="https://api.example.com/v1/positions?vessel={imo}&from={from}&to={to}"
# AIS_PROVIDER_KEY="your-ais-api-key"

# Pre-arrival risk — live port congestion from AIS (optional).
# Feeds the queue dimension of the Monte Carlo risk engine (/api/risk/pre-arrival).
# Unset means UNAVAILABLE, never mock: the route refuses to simulate rather than
# invent a queue, and the caller may pass `assumedWaitingHours` instead.
# Weather needs no key (Open-Meteo ensemble + ERA5 archive).
# AIS_CONGESTION_PROVIDER="datalastic"
# DATALASTIC_API_KEY="your-datalastic-key"
#
# Set to "mock" for a deterministic synthetic feed while developing. Everything
# it produces is stamped source="mock", which forces decision_grade=false on the
# stored assessment and attaches a SYNTHETIC DATA caveat. Refused outright when
# NODE_ENV=production unless ALLOW_MOCK_AIS_IN_PRODUCTION=1 is also set — mock
# congestion must never reach a commercial decision by accident.
# AIS_CONGESTION_PROVIDER="mock"
# ALLOW_MOCK_AIS_IN_PRODUCTION="1"

# Carbon price — EUA (EU Allowance) spot, for the ETS liability addendum.
# Unlike the AIS queue, this never fails hard: a clearly-labelled assumption
# beats no carbon report. Resolution order is ETS_EUA_PRICE_EUR (an explicit
# desk price), then a live provider, then the mock, then a documented static
# default. Quotes outside EUR 1-500 are rejected as provider malfunctions.
# CARBON_PRICE_PROVIDER="ice"
# CARBON_PRICE_URL="https://api.example.com/v1/eua/spot"
# CARBON_PRICE_KEY="your-carbon-data-key"
#
# "mock" gives a deterministic synthetic price, stable within a UTC day so a
# stored addendum renders the same number tomorrow. Stamped source="mock",
# which strips decision-grade status from the document. Refused when
# NODE_ENV=production unless ALLOW_MOCK_CARBON_PRICE_IN_PRODUCTION=1 — a
# synthetic price inside a document sent to a charterer is a fabricated
# financial figure.
# CARBON_PRICE_PROVIDER="mock"
# ALLOW_MOCK_CARBON_PRICE_IN_PRODUCTION="1"


# Live bunker-price feed (optional). Feeds the Eco-Speed optimizer's fuel-price
# input; unset → the optimizer falls back to its documented static default and
# labels the source accordingly. {fuel} and {port} are substituted.
# BUNKER_PROVIDER_URL="https://api.example.com/v1/bunker?fuel={fuel}&port={port}"
# BUNKER_PROVIDER_KEY="your-bunker-api-key"

# Inbound-email SoF ingestion (optional). Point your provider's inbound-parse
# webhook at POST /api/v1/ingestion/email with this secret in x-ingestion-secret.
# Unset → the endpoint returns 503 (channel off, not silently open). Route mail
# to sof+<companyId>@your-ingest-domain so the gateway can resolve the tenant.
# INGESTION_INBOUND_SECRET="your-random-secret"

# Inbound-SMS SoF ingestion (optional). Point a Twilio Messaging webhook at
# POST /api/v1/ingestion/sms. Requests are authenticated by the X-Twilio-Signature
# header (no shared secret); unset TWILIO_AUTH_TOKEN → the endpoint returns 503.
# The message is routed to the SENDING member's company, so the sender's phone
# must be on their LayGrounded account. Behind a proxy, set TWILIO_WEBHOOK_URL to
# the exact public URL Twilio calls (the signature is computed over it).
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_WEBHOOK_URL="https://your-domain/api/v1/ingestion/sms"

# --- Demand-letter delivery (optional) ---
# Emailing a demand letter to a counterparty is off until BOTH are set, and a
# provider transport is implemented in src/lib/drafting/delivery.ts. Until
# then the send endpoint honestly reports that nothing was sent (503) rather
# than simulating a delivery — the PDF is always available to download and
# send through your own channel.
# EMAIL_PROVIDER_API_KEY="your-email-provider-key"
# EMAIL_FROM_ADDRESS="claims@your-domain.com"

# --- Merkle notary anchoring (optional) ---
# Without an anchor, a time proof establishes record INTEGRITY but not TIME:
# its as-of is asserted by LayGrounded's own clock. Anchoring adds an
# independent attestation that the fingerprint existed before a given moment.
#
# ANCHOR_PROVIDER=rfc3161 with a TSA_URL is the path that works today. From a
# qualified trust service provider under eIDAS, a qualified electronic time
# stamp carries a legal presumption as to its date and time across the EU.
# Public test TSA: https://freetsa.org/tsr
# ANCHOR_PROVIDER="rfc3161"
# TSA_URL="https://freetsa.org/tsr"
# TSA_AUTH_HEADER="Bearer ..."          # only if your TSA requires auth
#
# ANCHOR_PROVIDER=ebsi is recognised but NOT implemented: EBSI is a
# permissioned network requiring onboarding, a registered DID and
# accreditation. It refuses rather than fabricating an anchor.

# --- Content-Security-Policy rollout (optional) ---
# The policy is built in next.config.ts from what the app actually loads
# (Supabase origin, pdf.js worker + WASM codecs, self-hosted fonts) and is
# ENFORCED by default. A CSP that blocks something needed fails silently for
# the user, so two switches exist:
#
# CSP_REPORT_ONLY=1  sends the identical policy as Content-Security-Policy-
#   Report-Only: nothing is blocked, and violations are POSTed to
#   /api/security/csp-report and logged as "[csp] <directive> blocked <uri>".
#   Run this way first in a new environment, watch the log, then unset.
# CSP_UPGRADE_INSECURE=1  adds upgrade-insecure-requests. Off by default
#   because it breaks the plain-http docker stack (Caddy serves
#   http://localhost:81); turn it on once the deployment terminates TLS.
# CSP_REPORT_ONLY="1"
# CSP_UPGRADE_INSECURE="1"

# --- MCP OAuth 2.1 authorization server (optional, for the MCP endpoint) ---
# The issuer origin the OAuth discovery documents publish
# (/.well-known/oauth-authorization-server and /.well-known/oauth-protected-
# resource). MUST be set in production: without it the issuer falls back to the
# request origin, which behind a proxy is derived from the client-controllable
# Host header — a forged Host could otherwise publish metadata pointing clients
# at an authorization server an attacker controls. Scheme + host, no path.
# OAUTH_ISSUER_URL="https://app.laygrounded.com"

# --- Scheduled sweeps (cron) ---
# Hit with `x-cron-secret: $CRON_SECRET`. Suggested cadence:
#   hourly  POST /api/v1/notary/run           Merkle time proofs (writes only on change)
#   hourly  POST /api/v1/audit/webhooks/run   time-bar deadline alerts (at-most-once per crossing)
#   hourly  POST /api/intel/congestion        refresh the port congestion matview
# All are idempotent, so a missed or repeated run is safe.

# --- Public port congestion index ---
# The /congestion page aggregates NOR-to-berth waiting times across tenants and
# publishes them as a free, k-anonymous dataset. It is OFF by default and the
# route 404s while unset: building the capability is one decision, publishing a
# dataset derived from customers' operating data is a separate one that should be
# made deliberately (and, most likely, reflected in your terms of service first).
# Per-company participation is the `companies.share_market_data` column, which
# defaults to true; set it false to withdraw a tenant. Cells are suppressed
# unless they hold >= 5 voyages from >= 3 distinct companies.
# PUBLIC_CONGESTION_INDEX="1"

# Cross-tenant settlement expectations (optional). When "1", the settlement
# expectation endpoint returns a market figure beside your own, drawn from
# other companies' settled claims. Aggregates only, withheld below 5 settled
# claims from 3 distinct companies — the same k-anonymity floors as the
# published port congestion index. Unset means own-book figures only.
# PUBLIC_MARKET_EXPECTATIONS="1"
