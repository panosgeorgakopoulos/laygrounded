{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@laygrounded/laytime-core": [
        "./packages/laytime-core/src/index.ts"
      ],
      "@laygrounded/laytime-core/*": [
        "./packages/laytime-core/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Written by packages/laytime-verify/scripts/build-artifacts.ts at build
    // time. entry-javy targets the Javy runtime, whose `Javy` global does not
    // exist in this project's lib set — typechecking it here would fail on a
    // file that is never part of the app.
    "packages/laytime-verify/dist",
    "packages/laytime-verify/src/entry-javy.ts",
    "packages/laytime-verify/src/entry-node.ts"
  ]
}
